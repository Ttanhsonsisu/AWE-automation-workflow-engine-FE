# =============================================================================
# AWE Frontend — Runtime Environment Variables
#
# Copy this file to `.env` and fill in values for your environment.
# These variables are injected into the running container at startup —
# NO rebuild required when you change them.
#
# Usage with Docker Compose:
#   env_file:
#     - .env
#   Or pass directly under `environment:` in docker-compose.yml
# =============================================================================

# ── Backend API ──────────────────────────────────────────────────────────────
# Base URL of the backend REST API reachable FROM THE BROWSER.
# In a Docker Compose setup with Nginx proxy, keep this as /api
# so Nginx proxies it to the backend container internally.
API_URL=http://localhost/api

# ── SignalR Hub ───────────────────────────────────────────────────────────────
# Full URL of the SignalR workflow hub.
SIGNALR_URL=http://localhost/hubs/workflow

# ── Keycloak / OIDC ───────────────────────────────────────────────────────────
# Keycloak realm URL — must be reachable FROM THE BROWSER.
OIDC_AUTHORITY=http://localhost:8081/realms/awe-auth

# Client ID registered in Keycloak (public client, no secret needed).
OIDC_CLIENT_ID=awe-fe

# Where Keycloak redirects after successful login.
# Must match "Valid Redirect URIs" in Keycloak client settings.
OIDC_REDIRECT_URI=http://localhost/

# Where Keycloak redirects after logout.
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost/

# OAuth2 scopes to request.
OIDC_SCOPE=openid profile email roles
