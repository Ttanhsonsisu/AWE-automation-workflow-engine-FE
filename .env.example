# =============================================================================
# AWE Frontend - Local Development Environment
#
# Copy this file to `.env` for `npm run dev`.
# Production runtime variables are configured in AWE-self-host/docker-compose.yml
# without the VITE_ prefix.
# =============================================================================

# ── Backend API ──────────────────────────────────────────────────────────────
# Base URL of the backend REST API reachable FROM THE BROWSER.
# In a Docker Compose setup with Nginx proxy, keep this as /api
# so Nginx proxies it to the backend container internally.
VITE_API_URL=http://localhost:18080/api

# ── SignalR Hub ───────────────────────────────────────────────────────────────
# Full URL of the SignalR workflow hub.
VITE_SIGNALR_URL=http://localhost:18080/hubs/workflow

# ── Keycloak / OIDC ───────────────────────────────────────────────────────────
# Keycloak realm URL — must be reachable FROM THE BROWSER.
VITE_OIDC_AUTHORITY=http://localhost:18081/realms/awe-auth

# Client ID registered in Keycloak (public client, no secret needed).
VITE_OIDC_CLIENT_ID=awe-fe

# Where Keycloak redirects after successful login.
# Must match "Valid Redirect URIs" in Keycloak client settings.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# Where Keycloak redirects after logout.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# OAuth2 scopes to request.
VITE_OIDC_SCOPE=openid profile email roles
